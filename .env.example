# =============================================================================
# Smart Traffic Congestion Alert - Environment Configuration (.env.example)
# Copy this file to .env and insert your personal API keys.
# Never commit the actual .env file or real API keys to version control.
# =============================================================================

# TomTom Developer API Key (Free tier: 2,500 non-tile requests/day, no credit card)
# Generate a free evaluation key at: https://developer.tomtom.com
TOMTOM_API_KEY=your_tomtom_api_key_here

# Campus Gate Coordinates (WGS84 Latitude, Longitude)
GATE_LATITUDE=12.9698
GATE_LONGITUDE=79.1559

# Live Polling Settings
LIVE_POLL_INTERVAL_MINUTES=5
MONITORING_WINDOW_START=08:00
MONITORING_WINDOW_END=10:00
TIMEZONE=Asia/Kolkata
