# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables & API keys
.env
.env.local
*.env
*.key

# Data files: allow raw and processed CSVs for reproducibility; ignore live logs
data/live/*.csv
data/live/*.sqlite
data/live/*.db
!data/**/.gitkeep

# Model Artifacts (allow serialized binaries and metadata for instant dashboard launch)
!models/*.joblib
!models/*.json
!models/.gitkeep

# Local documentation folder (never commit to git)
doc2/

# Streamlit runtime / local cache
.streamlit/secrets.toml

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
